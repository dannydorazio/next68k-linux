+/* With a 68060, let the ROM recover from bus errors it causes on purpose.
+ * Its handler pops the exception frame itself, through a table indexed by
+ * the frame format, and calls the 68060's access fault frame (format 4)
+ * bogus.  Add an entry for it in unused ROM space, next to the one for the
+ * 68040's (format 7, which follows "moveq #52,%d5; addl %d5,%fp@(N)").
+ * Then correct the CRC-32 of everything after the header, which the ROM
+ * checks first.  Found in ROM 3.3. */
+static uint32_t rom_get32(const uint8_t* p) {
+    return (uint32_t)p[0] << 24 | p[1] << 16 | p[2] << 8 | p[3];
+}
+
+static void rom_put32(uint8_t* p, uint32_t v) {
+    p[0] = v >> 24; p[1] = v >> 16; p[2] = v >> 8; p[3] = v;
+}
+
+static void rom_patch_68060(uint8_t* buf, int len) {
+    static const uint8_t pop52[] = { 0x7a, 0x34, 0xdb, 0xae };
+    int i, j, k, stub = len - 16;
+    uint32_t crc = ~0u;
+
+    for (i = 0; i + 10 <= len; i += 2) {
+        if (!memcmp(buf + i, pop52, 4) && buf[i + 6] == 0x60)
+            break;
+    }
+    for (j = 0; j + 32 <= len && i + 10 <= len; j += 2) {
+        if (rom_get32(buf + j + 28) == 0x01000000u + i)
+            break;
+    }
+    if (i + 10 > len || j + 32 > len ||
+        rom_get32(buf + j + 16) != rom_get32(buf + j + 20) ||
+        buf[stub] != 0 || memcmp(buf + stub, buf + stub + 1, 15)) {
+        Log_Printf(LOG_WARN, "ROM: no bus error handler to patch for the 68060");
+        return;
+    }
+    buf[stub + 0] = 0x50;   /* addql #8,%fp@(N) */
+    buf[stub + 1] = 0xae;
+    buf[stub + 2] = buf[i + 4];
+    buf[stub + 3] = buf[i + 5];
+    buf[stub + 4] = 0x4e;   /* jmp (where the 68040's case goes) */
+    buf[stub + 5] = 0xf9;
+    rom_put32(buf + stub + 6, 0x01000000u + i + 8 + (int8_t)buf[i + 7]);
+    rom_put32(buf + j + 16, 0x01000000u + stub);
+    for (i = 30; i < len; i++) {
+        crc ^= buf[i];
+        for (k = 0; k < 8; k++)
+            crc = (crc & 1) * 0xEDB88320 ^ (crc >> 1);
+    }
+    rom_put32(buf + 26, ~crc);
+    Log_Printf(LOG_WARN, "ROM: bus error handler patched for the 68060");
+}
+
