 /**
+ * Save the main window's screen to a file with a fixed name, as PNG if
+ * possible (for scripts: see SIGHUP in scc.c).
+ */
+void Grab_ScreenToFile(const char* szPathName) {
+	uint8_t* buffer = (uint8_t*)calloc(1, screen_w * screen_h * 4);
+	int nFileFormat = ConfigureParams.Printer.nFileFormat;
+	struct grab_format format;
+	bool result = false;
+	FILE* fp;
+	
+	if (!buffer) {
+		return;
+	}
+#if HAVE_LIBPNG
+	ConfigureParams.Printer.nFileFormat = FORMAT_PNG;
+#endif
+	if (Grab_ScreenFormat(ConfigureParams.Screen.nMode == SCREEN_SINGLE ?
+	                      ConfigureParams.Screen.nSingleModeSlot : 0,
+	                      buffer, &format)) {
+		fp = File_Open(szPathName, "wb");
+		if (fp) {
+#if HAVE_LIBPNG
+			result = Grab_MakePNG(fp, buffer, &format);
+#else
+			result = Grab_MakeTIFF(fp, buffer, &format);
+#endif
+			File_Close(fp);
+		}
+	}
+	ConfigureParams.Printer.nFileFormat = nFileFormat;
+	if (!result) {
+		Log_Printf(LOG_WARN, "[Grab] Error: Could not save screen to %s", szPathName);
+	}
+	free(buffer);
+}
