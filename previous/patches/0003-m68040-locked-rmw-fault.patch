68040 MMU: faults on the read cycle of a locked RMW

The read cycle of a locked read-modify-write (CAS, TAS) is checked for
write access.  When it faults, nothing has been written yet: the 68040
reports a read with LK set and no pending writeback, and the instruction
is restarted.  With a valid writeback, Linux's fault handler stored the
value and CAS then ran again, so the operation took effect twice: glibc's
fork() releases a lock with CAS on a copy-on-write page, which ended up
with a reader count of -1 in both processes.  The fault frame code comes
from WinUAE, which may have the same bug.

Upstream candidate.

--- src/cpu/cpummu.c
+++ src/cpu/cpummu.c
@@ -61,6 +61,7 @@
 uae_u16 mmu_opcode;
 bool mmu_restart;
 static bool locked_rmw_cycle;
+static bool locked_rmw_read;	/* the read cycle of a locked RMW */
 bool rmw_cycle;
 static bool ismoves;
 bool mmu_ttr_enabled, mmu_ttr_enabled_ins, mmu_ttr_enabled_data;
@@ -467,7 +468,19 @@
 		}
 		if (locked_rmw_cycle) {
 			ssw |= MMU_SSW_LK;
-			ssw &= ~MMU_SSW_RW;
+			if (locked_rmw_read) {
+				/* The read cycle of a locked RMW (CAS, TAS) is
+				 * checked for write access.  If it faults, nothing
+				 * has been written yet: the 68040 reports a read
+				 * with LK set and no pending writeback, and the
+				 * instruction is restarted.  A valid writeback here
+				 * would make the handler store a bogus value
+				 * before CAS runs again. */
+				ssw |= MMU_SSW_RW;
+				regs.wb3_status = 0;
+			} else {
+				ssw &= ~MMU_SSW_RW;
+			}
 #if MMUDEBUGMISC > 0
 			write_log (_T("040 MMU_SSW_LK!\n"));
 #endif
@@ -533,6 +546,7 @@
 	ismoves = false;
 	rmw_cycle = false;
 	locked_rmw_cycle = false;
+	locked_rmw_read = false;
 	regs.mmu_fault_addr = addr;
 
 #if 0
@@ -1712,6 +1726,7 @@
 {
 	uae_u32 v;
 	locked_rmw_cycle = true;
+	locked_rmw_read = true;
 	if (size == sz_byte) {
 		v = mmu_get_user_byte(addr, regs.s != 0, true, sz_byte, true);
 	} else if (size == sz_word) {
@@ -1727,6 +1742,7 @@
 			v = mmu_get_user_long(addr, regs.s != 0, true, sz_long, true);
 	}
 	locked_rmw_cycle = false;
+	locked_rmw_read = false;
 	return v;
 }
 
