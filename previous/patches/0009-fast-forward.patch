+/*
+ * PREVIOUS_FAST_FORWARD=N lets emulated time run up to N times as fast as
+ * real time ("max": as fast as the host allows), measured over each sync
+ * interval so that it can't catch up in bursts.  Without a limit, an idle
+ * guest waiting for the network or for typing races far ahead.
+ */
+static double fastForward;
+static uint64_t ffLastReal, ffLastHost;
+
 void Timing_Sync(void) {
 	int64_t realTimeOffset;
 	uint64_t realTime, hostTime;
@@ -114,6 +125,16 @@
 	host_lock(&timeLock);
 	saveTime = hostTime; /* save hostTime to be read by other threads */
 	host_unlock(&timeLock);
+	if (fastForward > 0) {
+		double allowed = ffLastHost + (realTime - ffLastReal) * fastForward;
+		if (hostTime > allowed && fastForward < DBL_MAX) {
+			host_sleep_us((uint64_t)((hostTime - allowed) / fastForward));
+			realTime = Timing_GetRealTime();
+		}
+		ffLastHost = hostTime;
+		ffLastReal = realTime;
+		return;
+	}
 	realTimeOffset = hostTime - realTime;
 	if (realTimeOffset > 0) {
 		host_sleep_us(realTimeOffset);
@@ -281,6 +302,22 @@
 	hardClockActual   = 0;
