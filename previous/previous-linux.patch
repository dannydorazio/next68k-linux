 }
+
+
+/* Host input
+ *
+ * PREVIOUS_INPUT names a FIFO.  Each line written to it is a command that
+ * types on the keyboard or works the mouse, for when there is no window to
+ * type into (and for scripts):
+ *
+ *   type TEXT          type TEXT (US layout; \n Return, \t Tab, \e Esc,
+ *                      \b Delete, \\ backslash)
+ *   key CODE [MODS]    press and release NeXT key CODE (hex) with the
+ *                      NEXTKEY_MOD_* bits MODS (hex) held
+ *   down CODE MODS     press, or release, a key; CODE 0 changes only
+ *   up CODE MODS       the modifiers
+ *   move DX DY         move the mouse (right and down positive)
+ *   button left|right down|up
+ *
+ * Events go out one at a time, KMS_HOST_GAP_US apart and only once the
+ * guest has taken the last one, as from a fast typist.
+ */
+#if !defined(_WIN32)
+#include <errno.h>
+#include <fcntl.h>
+#include <unistd.h>
+#define KMS_HOST_INPUT 1
+#endif
+
+#define KMS_HOST_GAP_US 10000
+#define KMS_HOST_QUEUE  4096
+
+enum { KMS_EV_DOWN, KMS_EV_UP, KMS_EV_MOVE, KMS_EV_BUTTON };
+
+static struct {
+    uint8_t kind;
+    uint8_t mods;
+    uint8_t code;   /* key, or 1 for the left button */
+    int8_t  dx, dy; /* or button down */
+} kms_host_queue[KMS_HOST_QUEUE];
+static int kms_host_head, kms_host_tail;
+static int kms_host_fd = -1;
+static char kms_host_line[1024];
+static int kms_host_len;
+static int kms_host_wait_us;
+
+static void kms_host_push(uint8_t kind, uint8_t mods, uint8_t code, int dx, int dy) {
+    int next = (kms_host_tail + 1) % KMS_HOST_QUEUE;
+
+    if (next == kms_host_head) {
+        Log_Printf(LOG_WARN, "[KMS] Host input queue full");
+        return;
+    }
+    kms_host_queue[kms_host_tail].kind = kind;
+    kms_host_queue[kms_host_tail].mods = mods;
+    kms_host_queue[kms_host_tail].code = code;
+    kms_host_queue[kms_host_tail].dx = dx;
+    kms_host_queue[kms_host_tail].dy = dy;
+    kms_host_tail = next;
+}
+
+static void kms_host_key(uint8_t code, uint8_t mods) {
+    if (mods) {
+        kms_host_push(KMS_EV_DOWN, mods, 0, 0, 0);
+    }
+    kms_host_push(KMS_EV_DOWN, mods, code, 0, 0);
+    kms_host_push(KMS_EV_UP, mods, code, 0, 0);
+    if (mods) {
+        kms_host_push(KMS_EV_UP, 0, 0, 0, 0);
+    }
+}
+
+/* US layout: unshifted and shifted characters of each key */
+static const struct {
+    uint8_t code;
+    char normal, shifted;
+} kms_host_chars[] = {
+    { NEXTKEY_a, 'a', 'A' }, { NEXTKEY_b, 'b', 'B' }, { NEXTKEY_c, 'c', 'C' },
+    { NEXTKEY_d, 'd', 'D' }, { NEXTKEY_e, 'e', 'E' }, { NEXTKEY_f, 'f', 'F' },
+    { NEXTKEY_g, 'g', 'G' }, { NEXTKEY_h, 'h', 'H' }, { NEXTKEY_i, 'i', 'I' },
+    { NEXTKEY_j, 'j', 'J' }, { NEXTKEY_k, 'k', 'K' }, { NEXTKEY_l, 'l', 'L' },
+    { NEXTKEY_m, 'm', 'M' }, { NEXTKEY_n, 'n', 'N' }, { NEXTKEY_o, 'o', 'O' },
+    { NEXTKEY_p, 'p', 'P' }, { NEXTKEY_q, 'q', 'Q' }, { NEXTKEY_r, 'r', 'R' },
+    { NEXTKEY_s, 's', 'S' }, { NEXTKEY_t, 't', 'T' }, { NEXTKEY_u, 'u', 'U' },
+    { NEXTKEY_v, 'v', 'V' }, { NEXTKEY_w, 'w', 'W' }, { NEXTKEY_x, 'x', 'X' },
+    { NEXTKEY_y, 'y', 'Y' }, { NEXTKEY_z, 'z', 'Z' },
+    { NEXTKEY_1, '1', '!' }, { NEXTKEY_2, '2', '@' }, { NEXTKEY_3, '3', '#' },
+    { NEXTKEY_4, '4', '$' }, { NEXTKEY_5, '5', '%' }, { NEXTKEY_6, '6', '^' },
+    { NEXTKEY_7, '7', '&' }, { NEXTKEY_8, '8', '*' }, { NEXTKEY_9, '9', '(' },
+    { NEXTKEY_0, '0', ')' },
+    { NEXTKEY_MINUS, '-', '_' }, { NEXTKEY_EQUALS, '=', '+' },
+    { NEXTKEY_OPENBRACKET, '[', '{' }, { NEXTKEY_CLOSEBRACKET, ']', '}' },
+    { NEXTKEY_BACKSLASH, '\\', '|' }, { NEXTKEY_SEMICOLON, ';', ':' },
+    { NEXTKEY_QUOTE, '\'', '"' }, { NEXTKEY_BACKQUOTE, '`', '~' },
+    { NEXTKEY_COMMA, ',', '<' }, { NEXTKEY_PERIOD, '.', '>' },
+    { NEXTKEY_SLASH, '/', '?' }, { NEXTKEY_SPACE, ' ', ' ' },
+    { NEXTKEY_RETURN, '\n', '\n' }, { NEXTKEY_TAB, '\t', '\t' },
+    { NEXTKEY_ESC, '\033', '\033' }, { NEXTKEY_DELETE, '\b', '\b' },
+};
+
+static void kms_host_type(const char *s) {
+    size_t i;
+    char c;
+
+    for (; *s; s++) {
+        c = *s;
+        if (c == '\\' && s[1]) {
+            switch (*++s) {
+                case 'n': c = '\n'; break;
+                case 't': c = '\t'; break;
+                case 'e': c = '\033'; break;
+                case 'b': c = '\b'; break;
+                default:  c = *s; break;
+            }
+        }
+        for (i = 0; i < sizeof(kms_host_chars) / sizeof(kms_host_chars[0]); i++) {
+            if (kms_host_chars[i].normal == c) {
+                kms_host_key(kms_host_chars[i].code, 0);
+                break;
+            }
+            if (kms_host_chars[i].shifted == c) {
+                kms_host_key(kms_host_chars[i].code, NEXTKEY_MOD_LSHIFT);
+                break;
+            }
+        }
+        if (i == sizeof(kms_host_chars) / sizeof(kms_host_chars[0])) {
+            Log_Printf(LOG_WARN, "[KMS] Host input: cannot type %02X", (uint8_t)c);
+        }
+    }
+}
+
+static void kms_host_command(char *line) {
+    char word[16], arg[16];
+    unsigned code, mods = 0;
+    int dx, dy, n;
+
+    if (sscanf(line, "%15s%n", word, &n) != 1) {
+        return;
+    }
+    if (!strcmp(word, "type")) {
+        kms_host_type(line[n] ? line + n + 1 : "");
+    } else if (!strcmp(word, "key") && sscanf(line + n, "%x %x", &code, &mods) >= 1) {
+        kms_host_key(code, mods);
+    } else if (!strcmp(word, "down") && sscanf(line + n, "%x %x", &code, &mods) == 2) {
+        kms_host_push(KMS_EV_DOWN, mods, code, 0, 0);
+    } else if (!strcmp(word, "up") && sscanf(line + n, "%x %x", &code, &mods) == 2) {
+        kms_host_push(KMS_EV_UP, mods, code, 0, 0);
+    } else if (!strcmp(word, "move") && sscanf(line + n, "%d %d", &dx, &dy) == 2) {
+        /* the mouse counts up to 63 per event */
+        while (dx || dy) {
+            int x = dx > 63 ? 63 : dx < -63 ? -63 : dx;
+            int y = dy > 63 ? 63 : dy < -63 ? -63 : dy;
+
+            kms_host_push(KMS_EV_MOVE, 0, 0, x, y);
+            dx -= x;
+            dy -= y;
+        }
+    } else if (!strcmp(word, "button") &&
+               sscanf(line + n, "%15s %15s", word, arg) == 2) {
+        kms_host_push(KMS_EV_BUTTON, 0, !strcmp(word, "left"), !strcmp(arg, "down"), 0);
+    } else {
+        Log_Printf(LOG_WARN, "[KMS] Host input: bad command: %s", line);
+    }
+}
+
+bool KMS_Host_Probe(void) {
+#if KMS_HOST_INPUT
+    static bool probed = false;
+    const char *path;
+
+    if (!probed) {
+        probed = true;
+        path = getenv("PREVIOUS_INPUT");
+        if (path && *path) {
+            kms_host_fd = open(path, O_RDONLY | O_NONBLOCK);
+            if (kms_host_fd < 0) {
+                Log_Printf(LOG_WARN, "[KMS] Cannot open %s: %s", path, strerror(errno));
+            } else {
+                /* a writer of our own, so reads never see end of file */
+                open(path, O_WRONLY | O_NONBLOCK);
+            }
+        }
+    }
+#endif
+    return kms_host_fd >= 0;
+}
+
+/* Called every millisecond or so from the SCC's host handler. */
+void KMS_Host_Handler(int us) {
+#if KMS_HOST_INPUT
+    char c;
+
+    if (kms_host_fd < 0) {
+        return;
+    }
+    while (read(kms_host_fd, &c, 1) == 1) {
+        if (c != '\n') {
+            if (kms_host_len < (int)sizeof(kms_host_line) - 1) {
+                kms_host_line[kms_host_len++] = c;
+            }
+            continue;
+        }
+        kms_host_line[kms_host_len] = 0;
+        kms_host_len = 0;
+        kms_host_command(kms_host_line);
+    }
+
+    if (kms_host_wait_us > 0) {
+        kms_host_wait_us -= us;
+        return;
+    }
+    if (kms_host_head == kms_host_tail || (kms.status.km & KM_RECEIVED)) {
+        return;
+    }
+    switch (kms_host_queue[kms_host_head].kind) {
+        case KMS_EV_DOWN:
+            kms_keydown(kms_host_queue[kms_host_head].mods, kms_host_queue[kms_host_head].code);
+            break;
+        case KMS_EV_UP:
+            kms_keyup(kms_host_queue[kms_host_head].mods, kms_host_queue[kms_host_head].code);
+            break;
+        case KMS_EV_MOVE:
+            kms_mouse_move(kms_host_queue[kms_host_head].dx, kms_host_queue[kms_host_head].dy);
+            break;
+        case KMS_EV_BUTTON:
+            kms_mouse_button(kms_host_queue[kms_host_head].code, kms_host_queue[kms_host_head].dx);
+            break;
+    }
+    kms_host_head = (kms_host_head + 1) % KMS_HOST_QUEUE;
+    kms_host_wait_us = KMS_HOST_GAP_US;
+#else
+    (void)us;
+#endif
+}
