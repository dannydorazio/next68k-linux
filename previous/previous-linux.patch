+/* Host side of the serial ports.
+ *
+ * PREVIOUS_SCC_A_LOG / PREVIOUS_SCC_B_LOG name a file that receives every
+ * byte transmitted on that channel.
+ *
+ * PREVIOUS_SCC_A_PTY / PREVIOUS_SCC_B_PTY name a path where a symlink to a
+ * new pseudo terminal is created.  Bytes transmitted on the channel can be
+ * read from that terminal, and bytes written to it are received by the
+ * channel.
+ *
+ * With a pseudo terminal on channel A, SIGUSR1 sends a break on it and
+ * SIGUSR2 raises an NMI.  PREVIOUS_SCREENSHOT names a file where SIGHUP
+ * saves the screen (PNG), for when the host can't capture the window.
+ * The handler also feeds host keyboard and mouse input (PREVIOUS_INPUT,
+ * see kms.c).
+ */
+#if !defined(_WIN32)
+#include <errno.h>
+#include <fcntl.h>
+#include <signal.h>
+#include <termios.h>
+#include <unistd.h>
+#define SCC_HOST_PTY 1
+#endif
+
+#define SCC_HOST_POLL_US 1000
+
+static struct {
+    FILE *log;
+    int   pty;      /* master side, -1 if none */
+    int   slave;    /* kept open so the master never sees a hangup */
+} scc_host[2] = { { NULL, -1, -1 }, { NULL, -1, -1 } };
+static bool scc_host_probed = false;
+static const char *scc_host_screenshot = NULL;
+
+#if SCC_HOST_PTY
+/* SIGUSR1 sends a break on channel A (for the kernel's magic SysRq). */
+static volatile sig_atomic_t scc_host_break_request = 0;
+static int scc_host_break_state = 0;
+
+static void scc_host_sigusr1(int sig) {
+    (void)sig;
+    scc_host_break_request = 1;
+}
+
+/* SIGUSR2 raises an NMI, as the keyboard's NMI key combination does. */
+static volatile sig_atomic_t scc_host_nmi_request = 0;
+
+static void scc_host_sigusr2(int sig) {
+    (void)sig;
+    scc_host_nmi_request = 1;
+}
+
+/* SIGHUP saves the screen to PREVIOUS_SCREENSHOT. */
+static volatile sig_atomic_t scc_host_screenshot_request = 0;
+
+static void scc_host_sighup(int sig) {
+    (void)sig;
+    scc_host_screenshot_request = 1;
+}
+
+static void scc_ext_interrupt(int ch) {
+    if ((scc[ch].wreg[W_MODE]&WR1_EXTIE) && (scc[ch].wreg[W_EXTSTAT]&RW15_BREAKIE)) {
+        scc_set_interrupt(ch?RR3_B_STATIP:RR3_A_STATIP);
+    }
+}
+
+/* A break: Break/Abort goes up, then a NUL is received as it ends. */
+static bool scc_host_break(void) {
+    switch (scc_host_break_state) {
+        case 0:
+            if (!scc_host_break_request) {
+                return false;
+            }
+            scc_host_break_request = 0;
+            scc[0].rreg[R_STATUS] |= RR0_BREAK;
+            scc_ext_interrupt(0);
+            scc_host_break_state = 1;
+            return true;
+        default:
+            scc[0].rreg[R_STATUS] &= ~RR0_BREAK;
+            scc_ext_interrupt(0);
+            scc_receive(0, 0x00);
+            scc_host_break_state = 0;
+            return true;
+    }
+}
+
+static int scc_host_open_pty(int ch, const char *link) {
+    struct termios tio;
+    const char *name;
+    int fd;
+
+    fd = posix_openpt(O_RDWR | O_NOCTTY);
+    if (fd < 0 || grantpt(fd) || unlockpt(fd) || !(name = ptsname(fd))) {
+        Log_Printf(LOG_WARN, "[SCC] Cannot create pseudo terminal for channel %c\n", ch?'B':'A');
+        if (fd >= 0) {
+            close(fd);
+        }
+        return -1;
+    }
+    scc_host[ch].slave = open(name, O_RDWR | O_NOCTTY);
+    if (tcgetattr(fd, &tio) == 0) {
+        cfmakeraw(&tio);
+        tcsetattr(fd, TCSANOW, &tio);
+    }
+    fcntl(fd, F_SETFL, fcntl(fd, F_GETFL) | O_NONBLOCK);
+
+    unlink(link);
+    if (symlink(name, link)) {
+        Log_Printf(LOG_WARN, "[SCC] Cannot link %s to %s\n", link, name);
+    }
+    Log_Printf(LOG_WARN, "[SCC] Channel %c is on %s (%s)\n", ch?'B':'A', name, link);
+    return fd;
+}
+#endif
+
+static void scc_host_probe(void) {
+    const char *log_env[2] = { "PREVIOUS_SCC_A_LOG", "PREVIOUS_SCC_B_LOG" };
+    const char *pty_env[2] = { "PREVIOUS_SCC_A_PTY", "PREVIOUS_SCC_B_PTY" };
+    int i;
+
+    if (scc_host_probed) {
+        return;
+    }
+    scc_host_probed = true;
+
+    for (i = 0; i < 2; i++) {
+        const char *path = getenv(log_env[i]);
+
+        if (path && *path) {
+            scc_host[i].log = fopen(path, "ab");
+            if (scc_host[i].log) {
+                setvbuf(scc_host[i].log, NULL, _IONBF, 0);
+            } else {
+                Log_Printf(LOG_WARN, "[SCC] Cannot open %s for channel %c\n", path, i?'B':'A');
+            }
+        }
+#if SCC_HOST_PTY
+        path = getenv(pty_env[i]);
+        if (path && *path) {
+            scc_host[i].pty = scc_host_open_pty(i, path);
+        }
+#endif
+    }
+#if SCC_HOST_PTY
+    if (scc_host[0].pty >= 0) {
+        signal(SIGUSR1, scc_host_sigusr1);
+        signal(SIGUSR2, scc_host_sigusr2);
+    }
+    scc_host_screenshot = getenv("PREVIOUS_SCREENSHOT");
+    if (scc_host_screenshot && *scc_host_screenshot) {
+        signal(SIGHUP, scc_host_sighup);
+    }
+#endif
+}
+
+static void scc_host_send(int ch, uint8_t val) {
+    if (scc_host[ch].log) {
+        fputc(val, scc_host[ch].log);
+    }
+#if SCC_HOST_PTY
+    if (scc_host[ch].pty >= 0) {
+        /* Drop output nobody is reading rather than stalling. */
+        (void)write(scc_host[ch].pty, &val, 1);
+    }
+#endif
+}
+
+/* Feed one byte from each pseudo terminal into an idle receiver. */
+void SCC_Host_Handler(void) {
+#if SCC_HOST_PTY
+    int ch;
+    uint8_t val;
+
+    if (scc_host_nmi_request) {
+        scc_host_nmi_request = 0;
+        Log_Printf(LOG_WARN, "[SCC] Host initiated NMI");
+        set_interrupt(INT_NMI, SET_INT);
+    }
+
+    if (scc_host_screenshot_request) {
+        scc_host_screenshot_request = 0;
+        Grab_ScreenToFile(scc_host_screenshot);
+    }
+
+    KMS_Host_Handler(SCC_HOST_POLL_US);
+
+    for (ch = 0; ch < 2; ch++) {
+        if (scc_host[ch].pty < 0 ||
+            !(scc[ch].wreg[W_RECCONT] & WR3_RXENABLE) ||
+            (scc[ch].rreg[R_STATUS] & RR0_RXAVAIL) ||
+            (ch && ConfigureParams.Tablet.nTabletType)) {
+            continue;
+        }
+        if (ch == 0 && scc_host_break()) {
+            continue;
+        }
+        if (read(scc_host[ch].pty, &val, 1) == 1) {
+            scc_receive(ch, val);
+        }
+    }
+#endif
+    CycInt_AddTimeEvent(SCC_HOST_POLL_US, 0, EVENT_SCC_HOST);
+}
